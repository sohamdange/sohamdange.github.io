#!/bin/sh
#
# Publishing gate for sohamdange.github.io
#
# This repository is PUBLIC. Everything committed here is world-readable on
# github.com forever, and anything under public/ or content/ is also served
# as a live URL. This hook blocks the mistakes that are hard to undo.
#
# Blocking checks exit 1 and explain the deliberate override.
# Warnings print and let the commit through.
#
# Enable (once per clone):  git config core.hooksPath .githooks

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

blocked=""
warned=""

# ── BLOCK 1: file types that are ignored for a reason ────────────────────────
# Reaching this means the file was force-added (git add -f) or slipped past a
# pattern. Documents, archives, and CAD/simulation output are the usual way
# personal or employer-owned material ends up on a public site.
risky='\.(pdf|docx?|xlsx?|zip|rar|7z|tar|tar\.gz|step|stp|iges|igs|sldprt|sldasm|slddrw|catpart|catproduct|prt|ipt|iam|f3d|dwg|dxf|odb|inp|cas|f06|rst|rth|pem|key|p12|pfx|crt)$'
risky_files=$(printf '%s\n' "$staged" | grep -Ei "$risky")
if [ -n "$risky_files" ]; then
  blocked="$blocked
Restricted file type staged (document / archive / CAD / credential):
$(printf '%s\n' "$risky_files" | sed 's/^/    /')"
fi

# ── BLOCK 2: credential-shaped strings in staged text ────────────────────────
secret_hits=""
printf '%s\n' "$staged" | while IFS= read -r f; do
  [ -f "$f" ] || continue
  # Skip binaries
  git diff --cached --numstat -- "$f" | grep -q '^-' && continue
  if git show ":$f" 2>/dev/null | grep -Eq 'BEGIN (RSA|OPENSSH|DSA|EC|PGP) PRIVATE KEY|gh[pousr]_[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9]{20,}'; then
    printf '%s\n' "$f" >> "$(git rev-parse --git-dir)/.secret_hits"
  fi
done
hits_file="$(git rev-parse --git-dir)/.secret_hits"
if [ -f "$hits_file" ]; then
  secret_hits=$(cat "$hits_file")
  rm -f "$hits_file"
  blocked="$blocked
Possible credential or API token in staged content:
$(printf '%s\n' "$secret_hits" | sed 's/^/    /')"
fi

# ── WARN 1: drafts are private on the site, not in the repo ──────────────────
draft_files=""
printf '%s\n' "$staged" | grep -E '^content/.*\.mdx$' | while IFS= read -r f; do
  [ -f "$f" ] || continue
  if git show ":$f" 2>/dev/null | head -20 | grep -Eq '^draft:[[:space:]]*true'; then
    printf '%s\n' "$f" >> "$(git rev-parse --git-dir)/.draft_hits"
  fi
done
drafts_file="$(git rev-parse --git-dir)/.draft_hits"
if [ -f "$drafts_file" ]; then
  draft_files=$(cat "$drafts_file")
  rm -f "$drafts_file"
  warned="$warned
Draft content staged. It will NOT appear on the site, but the text IS
readable in the public repo. Keep genuinely private work in /private/:
$(printf '%s\n' "$draft_files" | sed 's/^/    /')"
fi

# ── WARN 2: images may carry GPS coordinates in EXIF ─────────────────────────
images=$(printf '%s\n' "$staged" | grep -Ei '\.(jpe?g|tiff?|heic|png)$')
if [ -n "$images" ]; then
  if command -v exiftool >/dev/null 2>&1; then
    gps_hits=""
    for f in $images; do
      [ -f "$f" ] || continue
      if exiftool -s -GPSLatitude "$f" 2>/dev/null | grep -q .; then
        gps_hits="$gps_hits    $f
"
      fi
    done
    if [ -n "$gps_hits" ]; then
      blocked="$blocked
Image contains GPS coordinates in EXIF (strip with:
exiftool -all= FILE):
$gps_hits"
    fi
  else
    warned="$warned
Images staged but exiftool is not installed, so EXIF/GPS metadata was not
checked. Phone photos commonly embed the location they were taken:
$(printf '%s\n' "$images" | sed 's/^/    /')"
  fi
fi

# ── WARN 3: large files bloat a static site and the repo forever ─────────────
big=""
printf '%s\n' "$staged" | while IFS= read -r f; do
  [ -f "$f" ] || continue
  size=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
  [ -n "$size" ] && [ "$size" -gt 2097152 ] && printf '%s (%s KB)\n' "$f" "$((size / 1024))" >> "$(git rev-parse --git-dir)/.big_hits"
done
bigs_file="$(git rev-parse --git-dir)/.big_hits"
if [ -f "$bigs_file" ]; then
  big=$(cat "$bigs_file")
  rm -f "$bigs_file"
  warned="$warned
Large file staged (over 2 MB). Git history keeps it permanently:
$(printf '%s\n' "$big" | sed 's/^/    /')"
fi

# ── Report ───────────────────────────────────────────────────────────────────
if [ -n "$warned" ]; then
  printf '\n[publishing gate] WARNING%s\n' "$warned"
fi

if [ -n "$blocked" ]; then
  printf '\n[publishing gate] COMMIT BLOCKED%s\n' "$blocked"
  printf '\nThis repo is public: committed files stay in history even if deleted later.\n'
  printf 'If publishing this is genuinely intended, commit with --no-verify.\n'
  printf 'To keep it local instead, move it into /private/ (already gitignored).\n\n'
  exit 1
fi

exit 0
